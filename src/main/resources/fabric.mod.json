{
	"schemaVersion": 1,
	"id": "villager-item-finder",
	"version": "${version}",
	"name": "Villager Item Finder",
	"description": "Rerolls a selected librarian villager's lectern until it offers the enchanted book you are looking for.",
	"authors": [
		"Methean"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/villager-item-finder/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mkys.VillagerItemFinder"
		],
		"client": [
			"com.mkys.client.VillagerItemFinderClient"
		]
	},
	"mixins": [
		"villager-item-finder.mixins.json",
		{
			"config": "villager-item-finder.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}